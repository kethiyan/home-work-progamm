<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="newRequest.NewRequestController"
            style="-fx-background-color: #0a1628;">
    <top>
        <HBox style="-fx-background-color: #0d1f3c;
                     -fx-padding: 12 25; -fx-spacing: 15;
                     -fx-alignment: center-left;">
            <Label text="Fiber"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Net"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #00bcd4;"/>
            <Label HBox.hgrow="ALWAYS"/>
            <Button text="← Back" onAction="#goBack"
                    style="-fx-background-color: #1a3a5c; -fx-text-fill: white;
                           -fx-padding: 8 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #0a1628; -fx-background: #0a1628;">
            <content>
                <VBox style="-fx-padding: 30; -fx-spacing: 20; -fx-background-color: #0a1628;">

                    <Label text="New Connection Request"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Fill in the details to submit a new fiber connection request."
                           style="-fx-font-size: 13; -fx-text-fill: #8899aa;"/>

                    <VBox style="-fx-background-color: #0d1f3c;
                                 -fx-padding: 25; -fx-spacing: 15; -fx-background-radius: 12;">

                        <Label text="CUSTOMER INFORMATION"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #8899aa;"/>

                        <HBox style="-fx-spacing: 15;">
                            <VBox HBox.hgrow="ALWAYS" style="-fx-spacing: 5;">
                                <Label text="FULL NAME *"
                                       style="-fx-font-size: 11; -fx-text-fill: #8899aa;"/>
                                <TextField fx:id="fullName" promptText="Rajesh Kumar"
                                           style="-fx-background-color: #0a1628; -fx-text-fill: white;
                                                  -fx-border-color: #1a3a5c; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 10 15;
                                                  -fx-prompt-text-fill: #445566;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" style="-fx-spacing: 5;">
                                <Label text="COMPANY NAME"
                                       style="-fx-font-size: 11; -fx-text-fill: #8899aa;"/>
                                <TextField fx:id="companyName" promptText="Enter company name"
                                           style="-fx-background-color: #0a1628; -fx-text-fill: white;
                                                  -fx-border-color: #1a3a5c; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 10 15;
                                                  -fx-prompt-text-fill: #445566;"/>
                            </VBox>
                        </HBox>

                        <HBox style="-fx-spacing: 15;">
                            <VBox HBox.hgrow="ALWAYS" style="-fx-spacing: 5;">
                                <Label text="EMAIL ADDRESS *"
                                       style="-fx-font-size: 11; -fx-text-fill: #8899aa;"/>
                                <TextField fx:id="email" promptText="business@company.com"
                                           style="-fx-background-color: #0a1628; -fx-text-fill: white;
                                                  -fx-border-color: #1a3a5c; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 10 15;
                                                  -fx-prompt-text-fill: #445566;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" style="-fx-spacing: 5;">
                                <Label text="PHONE NUMBER"
                                       style="-fx-font-size: 11; -fx-text-fill: #8899aa;"/>
                                <TextField fx:id="phone" promptText="+91 XXXXX XXXXX"
                                           style="-fx-background-color: #0a1628; -fx-text-fill: white;
                                                  -fx-border-color: #1a3a5c; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 10 15;
                                                  -fx-prompt-text-fill: #445566;"/>
                            </VBox>
                        </HBox>

                        <Label text="SERVICE DETAILS"
                               style="-fx-font-size: 13; -fx-font-weight: bold;
                                      -fx-text-fill: #8899aa; -fx-padding: 10 0 0 0;"/>

                        <HBox style="-fx-spacing: 15;">
                            <VBox HBox.hgrow="ALWAYS" style="-fx-spacing: 5;">
                                <Label text="SELECT PLAN *"
                                       style="-fx-font-size: 11; -fx-text-fill: #8899aa;"/>
                                <ComboBox fx:id="planSelect" promptText="Select Plan"
                                          maxWidth="Infinity"
                                          style="-fx-background-color: #0a1628;
                                                 -fx-border-color: #1a3a5c;
                                                 -fx-border-radius: 8; -fx-background-radius: 8;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" style="-fx-spacing: 5;">
                                <Label text="PRIORITY"
                                       style="-fx-font-size: 11; -fx-text-fill: #8899aa;"/>
                                <ComboBox fx:id="priority" promptText="Select Priority"
                                          maxWidth="Infinity"
                                          style="-fx-background-color: #0a1628;
                                                 -fx-border-color: #1a3a5c;
                                                 -fx-border-radius: 8; -fx-background-radius: 8;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" style="-fx-spacing: 5;">
                                <Label text="INSTALL DATE"
                                       style="-fx-font-size: 11; -fx-text-fill: #8899aa;"/>
                                <DatePicker fx:id="installDate" maxWidth="Infinity"
                                            style="-fx-background-color: #0a1628;
                                                   -fx-border-color: #1a3a5c;
                                                   -fx-border-radius: 8; -fx-background-radius: 8;"/>
                            </VBox>
                        </HBox>

                        <VBox style="-fx-spacing: 5;">
                            <Label text="INSTALLATION ADDRESS *"
                                   style="-fx-font-size: 11; -fx-text-fill: #8899aa;"/>
                            <TextArea fx:id="address" prefRowCount="3"
                                      promptText="Full address including city, state, pincode"
                                      style="-fx-background-color: #0a1628; -fx-text-fill: white;
                                             -fx-border-color: #1a3a5c; -fx-border-radius: 8;
                                             -fx-background-radius: 8; -fx-padding: 10 15;
                                             -fx-prompt-text-fill: #445566;"/>
                        </VBox>

                        <VBox style="-fx-spacing: 5;">
                            <Label text="ADDITIONAL NOTES"
                                   style="-fx-font-size: 11; -fx-text-fill: #8899aa;"/>
                            <TextArea fx:id="notes" prefRowCount="3"
                                      promptText="Any special requirements..."
                                      style="-fx-background-color: #0a1628; -fx-text-fill: white;
                                             -fx-border-color: #1a3a5c; -fx-border-radius: 8;
                                             -fx-background-radius: 8; -fx-padding: 10 15;
                                             -fx-prompt-text-fill: #445566;"/>
                        </VBox>

                        <Label fx:id="msgLabel" text=""
                               style="-fx-font-size: 13;" visible="false"/>

                        <HBox style="-fx-spacing: 10; -fx-alignment: center-right;">
                            <Button text="Cancel" onAction="#cancel"
                                    style="-fx-background-color: #1a3a5c; -fx-text-fill: white;
                                           -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            <Button text="Save Draft" onAction="#saveDraft"
                                    style="-fx-background-color: #1a3a5c; -fx-text-fill: white;
                                           -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            <Button text="Submit Request" onAction="#submitRequest"
                                    style="-fx-background-color: #00bcd4; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-padding: 10 20;
                                           -fx-background-radius: 8; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>