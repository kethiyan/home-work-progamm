<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ApprovalReq.ApprovalReqController"
            style="-fx-background-color: #0a1628;">
    <top>
        <HBox style="-fx-background-color: #0d1f3c;
                     -fx-padding: 12 25; -fx-spacing: 15;
                     -fx-alignment: center-left;">
            <Label text="Fiber"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Net"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #00bcd4;"/>
            <Label HBox.hgrow="ALWAYS"/>
            <Button text="← Back" onAction="#goBack"
                    style="-fx-background-color: #1a3a5c; -fx-text-fill: white;
                           -fx-padding: 8 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </top>
    <center>
        <VBox style="-fx-padding: 30; -fx-spacing: 20; -fx-background-color: #0a1628;">

            <HBox style="-fx-alignment: center-left; -fx-spacing: 15;">
                <VBox>
                    <Label text="Approval Requests"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <HBox style="-fx-spacing: 8;">
                        <Label text="Pending:"
                               style="-fx-text-fill: #8899aa; -fx-font-size: 13;"/>
                        <Label fx:id="pendingCount" text="0"
                               style="-fx-text-fill: #ffa500;
                                      -fx-font-weight: bold; -fx-font-size: 13;"/>
                    </HBox>
                </VBox>
                <Label HBox.hgrow="ALWAYS"/>
                <Button text="✓ Approve" onAction="#approveSelected"
                        style="-fx-background-color: #00cc88; -fx-text-fill: white;
                               -fx-padding: 8 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button text="✕ Reject" onAction="#rejectSelected"
                        style="-fx-background-color: #ff5555; -fx-text-fill: white;
                               -fx-padding: 8 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button text="🔄" onAction="#refreshData"
                        style="-fx-background-color: #1a3a5c; -fx-text-fill: white;
                               -fx-padding: 8 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>

            <TableView fx:id="approvalTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #0d1f3c; -fx-border-color: transparent;">
                <columns>
                    <TableColumn fx:id="colReqId" text="REQUEST ID" prefWidth="150"/>
                    <TableColumn fx:id="colCustomer" text="CUSTOMER" prefWidth="180"/>
                    <TableColumn fx:id="colPlan" text="PLAN" prefWidth="180"/>
                    <TableColumn fx:id="colPriority" text="PRIORITY" prefWidth="100"/>
                    <TableColumn fx:id="colDate" text="SUBMITTED" prefWidth="150"/>
                </columns>
                <placeholder>
                    <Label text="No pending approvals"
                           style="-fx-text-fill: #8899aa; -fx-font-size: 14;"/>
                </placeholder>
            </TableView>

        </VBox>
    </center>
</BorderPane>