<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="BillDetail.BillDetailController"
            style="-fx-background-color: #0a1628;">
    <top>
        <HBox style="-fx-background-color: #0d1f3c;
                     -fx-padding: 12 25; -fx-spacing: 15;
                     -fx-alignment: center-left;">
            <Label text="Fiber"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Net"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #00bcd4;"/>
            <Label text="BUSINESS"
                   style="-fx-font-size: 10; -fx-text-fill: #00bcd4;"/>
            <Label HBox.hgrow="ALWAYS"/>
            <Button text="← Back" onAction="#goBack"
                    style="-fx-background-color: #1a3a5c; -fx-text-fill: white;
                           -fx-padding: 8 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #0a1628; -fx-background: #0a1628;">
            <content>
                <VBox style="-fx-padding: 30; -fx-spacing: 20; -fx-background-color: #0a1628;">

                    <HBox style="-fx-alignment: center-left; -fx-spacing: 15;">
                        <VBox>
                            <Label text="Bill Detail"
                                   style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Customer billing information"
                                   style="-fx-font-size: 13; -fx-text-fill: #8899aa;"/>
                        </VBox>
                        <Label HBox.hgrow="ALWAYS"/>
                        <Button text="+ New Bill" onAction="#newBill"
                                style="-fx-background-color: #00bcd4; -fx-text-fill: white;
                                       -fx-padding: 8 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Stats -->
                    <HBox style="-fx-spacing: 15;">
                        <VBox style="-fx-background-color: #0d1f3c; -fx-padding: 20;
                                     -fx-spacing: 8; -fx-background-radius: 12;" HBox.hgrow="ALWAYS">
                            <Label text="TOTAL BILLS" style="-fx-font-size: 11; -fx-text-fill: #8899aa;"/>
                            <Label fx:id="totalBills" text="0"
                                   style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        </VBox>
                        <VBox style="-fx-background-color: #0d1f3c; -fx-padding: 20;
                                     -fx-spacing: 8; -fx-background-radius: 12;" HBox.hgrow="ALWAYS">
                            <Label text="PAID" style="-fx-font-size: 11; -fx-text-fill: #8899aa;"/>
                            <Label fx:id="paidBills" text="0"
                                   style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #00cc88;"/>
                        </VBox>
                        <VBox style="-fx-background-color: #0d1f3c; -fx-padding: 20;
                                     -fx-spacing: 8; -fx-background-radius: 12;" HBox.hgrow="ALWAYS">
                            <Label text="PENDING" style="-fx-font-size: 11; -fx-text-fill: #8899aa;"/>
                            <Label fx:id="pendingBills" text="0"
                                   style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #ffa500;"/>
                        </VBox>
                        <VBox style="-fx-background-color: #0d1f3c; -fx-padding: 20;
                                     -fx-spacing: 8; -fx-background-radius: 12;" HBox.hgrow="ALWAYS">
                            <Label text="OVERDUE" style="-fx-font-size: 11; -fx-text-fill: #8899aa;"/>
                            <Label fx:id="overdueBills" text="0"
                                   style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #ff5555;"/>
                        </VBox>
                    </HBox>

                    <!-- Search -->
                    <HBox style="-fx-spacing: 10; -fx-alignment: center-left;">
                        <TextField fx:id="searchField"
                                   promptText="Search customer, invoice ID..."
                                   style="-fx-background-color: #0d1f3c; -fx-text-fill: white;
                                          -fx-border-color: #1a3a5c; -fx-border-radius: 8;
                                          -fx-background-radius: 8; -fx-padding: 8 15;
                                          -fx-pref-width: 280; -fx-prompt-text-fill: #445566;"/>
                        <ComboBox fx:id="statusFilter" promptText="Status"
                                  style="-fx-background-color: #0d1f3c;
                                         -fx-border-color: #1a3a5c;
                                         -fx-border-radius: 8; -fx-background-radius: 8;"/>
                        <Label HBox.hgrow="ALWAYS"/>
                        <Button text="🔄 Refresh" onAction="#refreshData"
                                style="-fx-background-color: #1a3a5c; -fx-text-fill: white;
                                       -fx-padding: 8 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Table -->
                    <VBox style="-fx-background-color: #0d1f3c;
                                 -fx-background-radius: 12; -fx-padding: 5;">
                        <TableView fx:id="billTable" prefHeight="400"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent;">
                            <columns>
                                <TableColumn fx:id="colBillId" text="INVOICE ID" prefWidth="140"/>
                                <TableColumn fx:id="colCustomer" text="CUSTOMER" prefWidth="180"/>
                                <TableColumn fx:id="colAmount" text="AMOUNT" prefWidth="120"/>
                                <TableColumn fx:id="colDate" text="DATE" prefWidth="130"/>
                                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="No bills found"
                                       style="-fx-text-fill: #8899aa; -fx-font-size: 14;"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>